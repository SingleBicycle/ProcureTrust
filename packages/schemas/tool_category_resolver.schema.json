{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procuretrust.ai/schemas/tool_category_resolver.schema.json",
  "title": "ToolCategoryResolver",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "current_category_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "candidate_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["text"]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category_id": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["category_id", "confidence"]
          }
        }
      },
      "required": ["category_id", "confidence", "alternatives"]
    }
  }
}
